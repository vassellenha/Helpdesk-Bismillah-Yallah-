APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=id
APP_FALLBACK_LOCALE=id
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Kill switch untuk email notifikasi tiket (lonceng in-app tidak terpengaruh).
# Setel false pada deploy pertama, nyalakan setelah aplikasi tenang — lihat
# catatan di config/notifications.php. Event mana yang dikirim diatur di sana.
NOTIFY_EMAIL_ENABLED=true

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# API data pegawai perusahaan (php artisan employees:sync).
# Driver "mock" membaca database/fixtures/employees.json — jalan tanpa kredensial.
#
# Driver "http" menuntut akses ke JARINGAN ADHI (VPN), bukan token: endpoint-nya
# tidak memakai bearer token sama sekali, tapi menolak IP luar dengan
# 401 {"error":"IP denied"}. Server produksi wajib berada di dalam jaringan ADHI,
# punya VPN, atau IP publiknya didaftarkan — lihat bagian 0 di docs/deployment.md.
EMPLOYEE_DIRECTORY_DRIVER=http
EMPLOYEE_DIRECTORY_URL=https://mobile.adhi.co.id
EMPLOYEE_DIRECTORY_TOKEN=
EMPLOYEE_DIRECTORY_ENDPOINT=/api/index.php/v2/kms2/karyawan/all
EMPLOYEE_DIRECTORY_TIMEOUT=120
EMPLOYEE_DIRECTORY_COLLECTION_KEY=data

# Opsional, hanya dipakai driver "mock". Kosong = fixture 25 pegawai contoh di
# database/fixtures/. Endpoint aslinya dibatasi per IP dan bisa menolak kapan
# saja, jadi simpan satu tarikan asli ke folder yang di-gitignore lalu arahkan ke
# situ. Relatif terhadap root proyek. JANGAN timpa fixture bawaan — data pribadi
# 3.847 karyawan akan masuk riwayat git secara permanen.
# EMPLOYEE_DIRECTORY_MOCK_FIXTURE=storage/app/private/employees-real.json
# Nonaktifkan pegawai yang tidak ada di respons API. Biarkan false sampai feed terpercaya.
EMPLOYEE_DIRECTORY_DEACTIVATE_MISSING=false

# Portal SSO SINTA. Driver "mock" mensimulasikan login secara lokal (pilih pegawai
# di halaman /auth/sso/login) sehingga alurnya bisa diuji tanpa kredensial.
# Ganti ke "oidc" dan isi endpoint-nya setelah spesifikasi SINTA tersedia.
SSO_DRIVER=mock
SSO_CLIENT_ID=
SSO_CLIENT_SECRET=
SSO_AUTHORIZE_URL=
SSO_TOKEN_URL=
SSO_USERINFO_URL=
SSO_LOGOUT_URL=
SSO_SCOPES="openid profile email"
SSO_TIMEOUT=15
